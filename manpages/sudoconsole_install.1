.TH "sudoconsole" "1" "Aug 2026" "sudoconsole " "sudoconsole Manual"

.SH NAME
sudoconsole-install - Install sudoconsole adapters for detected CLI agents


.SH SYNOPSIS
\fBsudoconsole install [flags]\fP


.SH DESCRIPTION
install registers sudoconsole with every detected CLI agent
(Kilo, Claude Code, Gemini, Aider, Codex, Copilot). The operation is
idempotent: running it twice yields the same state. Use --force to
overwrite an existing integration, --dry-run to preview the changes,
--kind to restrict the operation to a specific agent, and --yes to skip
the interactive confirmation.


.SH OPTIONS
\fB--bin-dir\fP=""
	override the bin directory for wrappers (default: config agent.bin_dir)

.PP
\fB--dry-run\fP[=false]
	report what would change without touching the filesystem

.PP
\fB--force\fP[=false]
	overwrite existing integration files

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for install

.PP
\fB--kind\fP=[]
	agent kinds to install (kilo, claude, gemini, aider, codex, copilot, generic)

.PP
\fB--policy-mode\fP=""
	override the policy mode for this invocation (blocklist|allowlist|audit)

.PP
\fB--yes\fP[=false]
	skip the interactive confirmation prompt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--cache-timeout\fP=0
	sudo cache timeout in seconds (60-3600); overrides config file

.PP
\fB--config\fP=""
	path to the TOML config file (default: platform XDG/Application Support location)

.PP
\fB--format\fP=""
	output format: human or json (overrides config file)

.PP
\fB--log-level\fP=""
	log level: silent, error, warn, info, debug (overrides config file)


.SH EXAMPLE
.EX
  sudoconsole install
  sudoconsole install --kind kilo --kind claude
  sudoconsole install --dry-run --force
.EE


.SH SEE ALSO
\fBsudoconsole(1)\fP, \fBsudoconsole-install-uninstall(1)\fP


