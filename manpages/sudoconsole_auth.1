.SH NAME
sudoconsole-auth - Authenticate with sudo and cache the credentials


.SH SYNOPSIS
\fBsudoconsole auth [flags]\fP


.SH DESCRIPTION
auth prompts for the sudo password on a secure PTY and
caches the credentials for the configured timeout. Safe to run from any
script; the password is never echoed, logged or written to disk.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for auth

.PP
\fB--no-tty\fP[=false]
	read the password from $SUDOCONSOLE_PASSWORD instead of the TTY (testing only)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--cache-timeout\fP=0
	sudo cache timeout in seconds (60-3600); overrides config file

.PP
\fB--config\fP=""
	path to the TOML config file (default: platform XDG/Application Support location)

.PP
\fB--format\fP=""
	output format: human or json (overrides config file)

.PP
\fB--log-level\fP=""
	log level: silent, error, warn, info, debug (overrides config file)


.SH EXAMPLE
.EX
  # interactive prompt
  sudoconsole auth

  # non-interactive (testing only) via env var
  SUDOCONSOLE_PASSWORD=secret sudoconsole auth --no-tty
.EE


.SH SEE ALSO
\fBsudoconsole(1)\fP


