.TH "sudoconsole" "1" "Aug 2026" "sudoconsole " "sudoconsole Manual"

.SH NAME
sudoconsole-install-uninstall - Remove sudoconsole adapters from every detected CLI agent


.SH SYNOPSIS
\fBsudoconsole install uninstall [flags]\fP


.SH DESCRIPTION
uninstall removes every integration that 'sudoconsole install'
created. It is idempotent: missing files are silently skipped.


.SH OPTIONS
\fB--dry-run\fP[=false]
	report what would change without touching the filesystem

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for uninstall

.PP
\fB--kind\fP=[]
	agent kinds to uninstall

.PP
\fB--yes\fP[=false]
	skip the interactive confirmation prompt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--cache-timeout\fP=0
	sudo cache timeout in seconds (60-3600); overrides config file

.PP
\fB--config\fP=""
	path to the TOML config file (default: platform XDG/Application Support location)

.PP
\fB--format\fP=""
	output format: human or json (overrides config file)

.PP
\fB--log-level\fP=""
	log level: silent, error, warn, info, debug (overrides config file)


.SH EXAMPLE
.EX
  sudoconsole uninstall
  sudoconsole uninstall --kind kilo
.EE


.SH SEE ALSO
\fBsudoconsole-install(1)\fP


