.SH NAME
sudoconsole-audit-tail - Print the last N entries from the audit log


.SH SYNOPSIS
\fBsudoconsole audit tail [flags]\fP


.SH DESCRIPTION
tail prints the last N records of the JSONL audit log written
by sudoconsole. The path is taken from the loaded configuration
(policy.audit.log_file). Defaults to 20 records.


.SH OPTIONS
\fB--count\fP=20
	number of recent records to display

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for tail


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--cache-timeout\fP=0
	sudo cache timeout in seconds (60-3600); overrides config file

.PP
\fB--config\fP=""
	path to the TOML config file (default: platform XDG/Application Support location)

.PP
\fB--format\fP=""
	output format: human or json (overrides config file)

.PP
\fB--log-level\fP=""
	log level: silent, error, warn, info, debug (overrides config file)


.SH EXAMPLE
.EX
  sudoconsole audit tail
  sudoconsole audit tail --count 5
  sudoconsole --format json audit tail --count 50
.EE


.SH SEE ALSO
\fBsudoconsole-audit(1)\fP


