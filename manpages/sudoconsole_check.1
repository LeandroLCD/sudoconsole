.TH "sudoconsole" "1" "Aug 2026" "sudoconsole " "sudoconsole Manual"

.SH NAME
sudoconsole-check - Check whether the sudo cache is active


.SH SYNOPSIS
\fBsudoconsole check [flags]\fP


.SH DESCRIPTION
check inspects the sudo timestamp file and exits 0 if the
cache is currently valid, 1 otherwise. Useful for scripts that want to
gate a sudo call on a previous 'sudoconsole auth'.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for check


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--cache-timeout\fP=0
	sudo cache timeout in seconds (60-3600); overrides config file

.PP
\fB--config\fP=""
	path to the TOML config file (default: platform XDG/Application Support location)

.PP
\fB--format\fP=""
	output format: human or json (overrides config file)

.PP
\fB--log-level\fP=""
	log level: silent, error, warn, info, debug (overrides config file)


.SH EXAMPLE
.EX
  # exit 0 if cache active, 1 otherwise
  sudoconsole check && echo "cached" || echo "needs auth"

  # machine-readable output
  sudoconsole --format json check
.EE


.SH SEE ALSO
\fBsudoconsole(1)\fP


