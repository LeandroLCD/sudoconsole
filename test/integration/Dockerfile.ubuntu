# Integration test container for Ubuntu 24.04.
#
# The host CI builds the test binary (`integration.test`) and the
# sudoconsole binary outside the container and bind-mounts / copies
# them in. This image only needs sudo + a test user.
ARG BASE=ubuntu:24.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        sudo ca-certificates coreutils \
 && rm -rf /var/lib/apt/lists/*

# Two test users:
#   sudotest  — NOPASSWD sudoer for the common path (no password).
#   sudopwd   — password-protected sudoer for the password-prompt test.
RUN useradd -m -s /bin/bash sudotest \
 && useradd -m -s /bin/bash sudopwd \
 && echo 'sudopwd:sudopwd' | chpasswd

# Sudoers: passwordless for sudotest, password required for sudopwd,
# cache timeout forced to 0 so the "cache expired" test is deterministic.
RUN printf '%s\n' \
        'Defaults    env_keep += "SUDOCONSOLE_PASSWORD SUDOCONSOLE_CONFIG SUDOCONSOLE_AUDIT_LOG"' \
        'Defaults    timestamp_timeout=0' \
        'sudotest    ALL=(ALL) NOPASSWD: ALL' \
        'sudopwd     ALL=(ALL) ALL' \
        > /etc/sudoers.d/sudoconsole-test \
 && chmod 0440 /etc/sudoers.d/sudoconsole-test

USER sudotest
WORKDIR /home/sudotest

# Default entrypoint runs the pre-built test binary. The CI workflow
# bind-mounts `bin/integration.test` and `bin/sudoconsole` at runtime.
ENTRYPOINT ["/bin/integration.test"]
CMD ["-test.v"]