# Integration test container for Ubuntu 24.04.
#
# The host CI builds the test binary (`integration.test`) and the
# sudoconsole binary outside the container and copies them in via the
# `--build-context artifacts=./bin` option. This image only needs
# sudo + a test user.
ARG BASE=ubuntu:24.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        sudo ca-certificates coreutils \
 && rm -rf /var/lib/apt/lists/*

# Two test users:
#   sudotest  — NOPASSWD sudoer for the common path (no password).
#   sudopwd   — password-protected sudoer for the password-prompt test.
RUN useradd -m -s /bin/bash sudotest \
 && useradd -m -s /bin/bash sudopwd \
 && echo 'sudopwd:sudopwd' | chpasswd

# Sudoers: passwordless for sudotest, password required for sudopwd,
# cache timeout 60s (long enough for the suite, short enough that
# the "expired" branch is reachable if a test wants it).
# set_home is disabled and HOME is added to env_keep so `sudo -u sudopwd -E`
# preserves the test-runner's $HOME (needed so /tmp/... config + audit
# paths stay accessible to both users).
RUN printf '%s\n' \
        'Defaults    env_keep += "SUDOCONSOLE_PASSWORD SUDOCONSOLE_CONFIG SUDOCONSOLE_AUDIT_LOG HOME XDG_CONFIG_HOME XDG_DATA_HOME"' \
        'Defaults    !set_home' \
        'Defaults    timestamp_timeout=60' \
        'sudotest    ALL=(ALL) NOPASSWD: ALL' \
        'sudopwd     ALL=(ALL) ALL' \
        > /etc/sudoers.d/sudoconsole-test \
 && chmod 0440 /etc/sudoers.d/sudoconsole-test

# Copy the test binary + sudoconsole binary from the build context.
# Names follow the artifacts produced by `make build` and the
# `go test -c` step in the integration workflow.
COPY --from=artifacts sudoconsole /usr/local/bin/sudoconsole
COPY --from=artifacts integration.test /usr/local/bin/integration.test
RUN chmod +x /usr/local/bin/sudoconsole /usr/local/bin/integration.test

USER sudotest
WORKDIR /home/sudotest

ENTRYPOINT ["/usr/local/bin/integration.test"]
CMD ["-test.v"]